# Exclude version control, virtualenvs, and caches
.git
.gitignore
.venv
venv
env
build
dist
*.egg-info
**/__pycache__
*.py[cod]
*$py.class
.mypy_cache
.ruff_cache
.pytest_cache
.coverage
htmlcov

